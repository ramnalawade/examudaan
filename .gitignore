# ============================================================
# ExamUdaan — .gitignore
# Monorepo: Next.js (apps/web) + Python Scrapy (apps/scraper)
# ============================================================

# ── Environment / Secrets ───────────────────────────────────
# NEVER commit .env files — they contain DB passwords, API keys
.env
.env.*
!.env.example          # Allow example/template env files
**/.env
**/.env.*
!**/.env.example

# ── Node.js / Next.js ───────────────────────────────────────
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
build/
dist/
.npm/
.pnp/
.pnp.js
.yarn/

# npm/yarn/pnpm lock files (keep package-lock.json but ignore others if desired)
# Uncomment below to also ignore lock files:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Next.js cache / telemetry
.next/
.vercel/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ── Python / Scrapy ─────────────────────────────────────────
# Virtual environments — never commit these (large + machine-specific)
.venv/
venv/
env/
ENV/
**/.venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg
*.egg-info/
dist/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
.eggs/
*.so

# Scrapy output / log files
*.log
*.jl
*.json.gz
scrapy_output/
crawls/
items.csv
items.json
/tmp/

# Jupyter notebooks (if any)
.ipynb_checkpoints/

# ── packages/ directory ──────────────────────────────────────
# SQL migrations are committed; exclude generated artifacts
packages/**/dist/
packages/**/node_modules/

# ── Database / Sensitive data ────────────────────────────────
*.sql.bak
*.dump
*.db
*.sqlite
*.sqlite3
db_backup/

# ── IDE / OS files ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code (keep settings.json and extensions.json — useful for team)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Test / Coverage ─────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
.pytest_cache/
htmlcov/
.tox/

# ── Temporary / scratch files ───────────────────────────────
scratch/
*.tmp
*.temp
*.swp
*.swo
*~

# ── Build artifacts ─────────────────────────────────────────
*.tgz
*.tar.gz
*.zip

# ── Proxy / cache files (Scrapy) ────────────────────────────
.scrapy/
httpcache/

# ── Agent / AI memory files (internal tool artifacts) ───────
# Keep GEMINI.md and CONTINUATION.md — they are project docs
# Exclude any agent scratch/private data
.agents/*/scratch/
