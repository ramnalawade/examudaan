        <mxCell id="118" value="&lt;b&gt;API &amp; INGESTION GATEWAY&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748B'&gt;Scrapy Crawler Daemon, Scheduled Runner, Next.js REST API &amp; Route Dispatcher&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontColor=#334155;fontSize=10;align=left;spacingLeft=12;shadow=0;" vertex="1" parent="1">
