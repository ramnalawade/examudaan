        <mxCell id="168" value="&lt;b&gt;SECURITY &amp; COMPLIANCE (SecOps)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Anti-Scraping Throttling&lt;/b&gt;: 1-3s download delays, domain-specific concurrency = 1&lt;br/&gt;• &lt;b&gt;Non-Affiliation Compliance&lt;/b&gt;: Prominent disclaimer that ExamUdaan is a private portal&lt;br/&gt;• &lt;b&gt;External Link Integrity&lt;/b&gt;: Official PDF links always point to gov domains with &lt;code&gt;rel='noopener'&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;SQL Injection Prevention&lt;/b&gt;: 100% parameterized queries in &lt;code&gt;pgdb.js&lt;/code&gt; &amp; &lt;code&gt;db.py&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
