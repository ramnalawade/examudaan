        </mxCell>
        <mxCell id="169" value="&lt;b&gt;OPERATIONS &amp; RELIABILITY (Ops)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Automated Crawl Logs&lt;/b&gt;: Timestamps, duration, scraped count in &lt;code&gt;scraper_YYYYMMDD_HHMMSS.log&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Brevo Email Alerts&lt;/b&gt;: Instant email summary to admin on spider success / failure&lt;br/&gt;• &lt;b&gt;Graceful Failures&lt;/b&gt;: Spiders catch timeouts &amp; 404s without crashing subsequent crawlers&lt;br/&gt;• &lt;b&gt;Next.js App Router Build&lt;/b&gt;: All 43 static &amp; dynamic routes validated (PASSED code 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1E293B;fontSize=9;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1630" y="690" width="565" height="115" as="geometry"/>
