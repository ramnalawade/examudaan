# ============================================================
# .gitattributes — Normalize line endings for cross-platform
# ExamUdaan: Windows dev + Linux production (Vercel/Railway)
# ============================================================

# Default: auto-normalize all text files
* text=auto

# Force LF on all JS/TS/CSS/JSON/Python source files (Linux servers need LF)
*.js     text eol=lf
*.ts     text eol=lf
*.jsx    text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.env    text eol=lf
*.sql    text eol=lf
*.txt    text eol=lf
*.toml   text eol=lf
*.ini    text eol=lf

# PowerShell scripts — keep CRLF (Windows native)
*.ps1    text eol=crlf

# Binary files — no line ending conversion
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.avif   binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.tgz    binary
*.tar.gz binary
*.drawio binary
